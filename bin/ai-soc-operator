#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="${AI_SOC_HOME:-$HOME/ai-soc-operator}"
if [[ ! -d "$REPO_DIR" ]]; then
  REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

PYTHON="python3"
if [[ -x "$REPO_DIR/.venv/bin/python" ]]; then
  PYTHON="$REPO_DIR/.venv/bin/python"
fi

cd "$REPO_DIR"

# Ensure data/ directory exists and is owned by the current user.
# Bootstrap may have created it as root if run with sudo.
DATA_DIR="$REPO_DIR/data"
if [[ ! -d "$DATA_DIR" ]]; then
  mkdir -p "$DATA_DIR"
elif [[ ! -w "$DATA_DIR" ]]; then
  echo ""
  echo "[ERROR] $DATA_DIR is not writable by $(whoami)."
  echo "  Fix with:  sudo chown -R \$USER \"$DATA_DIR\""
  echo "  Then re-run: ai-soc-operator"
  echo ""
  exit 1
fi

# Detect local IP for display
LOCAL_IP=$(python3 -c "
import socket
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect(('8.8.8.8', 80))
    print(s.getsockname()[0])
    s.close()
except Exception:
    print('127.0.0.1')
" 2>/dev/null || echo "127.0.0.1")

PORT="${AI_SOC_PORT:-5000}"
HTTPS_MARKER="$REPO_DIR/config/local-https.json"

if [[ -f "$HTTPS_MARKER" ]]; then
  BACKEND_PORT=5000
  SESSION_SECRET_FILE="$DATA_DIR/.session_secret"
  CREDENTIAL_KEY_FILE="$DATA_DIR/.credential_key"
  if [[ ! -r "$SESSION_SECRET_FILE" || ! -r "$CREDENTIAL_KEY_FILE" ]]; then
    echo "[ERROR] Local HTTPS secrets are missing. Re-run bootstrap."
    exit 1
  fi
  export AI_SOC_ENV=production
  export AI_SOC_BEHIND_PROXY=1
  export AI_SOC_GUNICORN_BIND="127.0.0.1:$BACKEND_PORT"
  export AI_SOC_SESSION_SECRET="$(tr -d '\r\n' < "$SESSION_SECRET_FILE")"
  export AI_SOC_CREDENTIAL_KEY="$(tr -d '\r\n' < "$CREDENTIAL_KEY_FILE")"

  echo ""
  echo "=================================================="
  echo "  AI SOC Operator"
  echo "  Local:   https://localhost"
  echo "  Network: https://$LOCAL_IP"
  echo "=================================================="
  echo ""
  echo "Press Ctrl+C to stop the application."
  echo ""
  exec "$PYTHON" -m gunicorn --config "$REPO_DIR/deploy/gunicorn.conf.py" web.app:app
fi

echo ""
echo "=================================================="
echo "  AI SOC Operator"
echo "  Local:   http://localhost:$PORT"
echo "  Network: http://$LOCAL_IP:$PORT"
echo "=================================================="
echo ""
echo "Press Ctrl+C to stop."
echo ""

exec "$PYTHON" -m web.app
